#!/usr/bin/env bash

set -euo pipefail

LOCAL_BIN="${LOCAL_BIN:-$HOME/.local/bin}"
mkdir -p "$LOCAL_BIN"
LOCAL_BIN="$(cd "$LOCAL_BIN" && pwd)"
VERSION="1-alpha-20251107-1"
ARCH="$(uname -m)"

# Digests from the pinned release's GitHub asset metadata, not the mutable tag alone.
case "$ARCH" in
  x86_64) SHA256="c20cd71e3a4e3b80c3483cef793cda3f4e990aca14014d23c544ca3ce1270b4d" ;;
  aarch64) SHA256="620095110d693282b8ebeb244a95b5e911cf8f65f76c88b4b47d16ae6346fcff" ;;
  i386) SHA256="a2a88d142aac42db779483ca07c10dbf318b27f514691107fc88a202faae17b5" ;;
  armhf) SHA256="e359161979fa4bee50b92ce7102fb510299caebf34f711d983fba7a8f4bb1c2e" ;;
  *) echo "Error: Unsupported linuxdeploy architecture: $ARCH" >&2; exit 1 ;;
esac

APPIMAGE_NAME="linuxdeploy-$ARCH.AppImage"
APPIMAGE_PATH="$LOCAL_BIN/$APPIMAGE_NAME"
DOWNLOAD_PATH=""
trap 'if [[ -n "$DOWNLOAD_PATH" ]]; then rm -f "$DOWNLOAD_PATH"; fi' EXIT

verify_digest() {
  local actual
  actual="$(sha256sum "$1")"
  if [[ "${actual%% *}" != "$SHA256" ]]; then
    echo "Error: linuxdeploy SHA256 mismatch for $1; refusing to execute or cache it." >&2
    return 1
  fi
}

if [[ -e "$APPIMAGE_PATH" || -L "$APPIMAGE_PATH" ]]; then
  verify_digest "$APPIMAGE_PATH"
  echo "Found verified $APPIMAGE_NAME in $LOCAL_BIN." >&2
else
  URL="https://github.com/linuxdeploy/linuxdeploy/releases/download/$VERSION/$APPIMAGE_NAME"
  echo "Downloading $URL..." >&2
  DOWNLOAD_PATH="$(mktemp "$LOCAL_BIN/.linuxdeploy-download.XXXXXX")"
  curl --fail --location --proto '=https' --proto-redir '=https' \
    --connect-timeout 15 --max-time 180 --retry 2 --retry-max-time 300 \
    "$URL" --output "$DOWNLOAD_PATH"
  verify_digest "$DOWNLOAD_PATH"
  chmod 755 "$DOWNLOAD_PATH"
  mv "$DOWNLOAD_PATH" "$APPIMAGE_PATH"
  DOWNLOAD_PATH=""
fi

chmod 755 "$APPIMAGE_PATH"
ln -sf "$APPIMAGE_PATH" "$LOCAL_BIN/linuxdeploy"
printf '%s\n' "$LOCAL_BIN/linuxdeploy"
