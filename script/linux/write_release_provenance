#!/usr/bin/env python3
"""Record candidate provenance with the validated classifier checkout payload."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
from runpy import run_path
import tarfile
import tempfile
import tomllib
from types import SimpleNamespace


sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[2]
validator = SimpleNamespace(**run_path(str(ROOT / "script/linux/verify_release_model")))


def command(*args):
    return subprocess.check_output(args, cwd=ROOT, text=True, timeout=30).strip()


def validate_runtime(runtime, deb, appimage, source_commit):
    if runtime.get("status") != "passed" or runtime.get("mechanics_only") is not False:
        raise ValueError("clean runtime acceptance is missing or mechanics-only")
    if runtime.get("launch_mode") != "native-direct-exec" or runtime.get("launcher_source") not in (None, "candidate"):
        raise ValueError("runtime acceptance requires an unmodified native AppImage launch")
    if runtime.get("source_commit") != source_commit:
        raise ValueError("runtime acceptance does not match the source revision")
    for kind, path in [("deb", deb), ("appimage", appimage)]:
        with path.open("rb") as artifact:
            digest = hashlib.file_digest(artifact, "sha256").hexdigest()
        if runtime.get("inputs", {}).get(kind) != digest:
            raise ValueError(f"runtime acceptance does not match the {kind} candidate")
    libraries = runtime.get("bundled_libraries")
    if not isinstance(libraries, list) or len(libraries) > 1:
        raise ValueError("native runtime shared-library inventory is missing or invalid")
    for library in libraries:
        if (
            not isinstance(library, dict)
            or set(library) != {"path", "soname", "sha256"}
            or library["path"] != "usr/lib/liblzma.so.5"
            or library["soname"] != "liblzma.so.5"
            or not isinstance(library["sha256"], str)
            or not re.fullmatch(r"[a-f0-9]{64}", library["sha256"])
        ):
            raise ValueError("unexpected native runtime shared-library inventory")
    return libraries


def validate_model_evidence(output, model):
    if model["state"] == "original-model":
        log_name = "inference.log"
        test_name = "onnx::tests::test_v3_model_runs_real_inference"
        checks = {"real_v3_inference": "passed", "upstream_heuristic_fallback": "not-applicable"}
    elif model["state"] == "upstream-lfs-pointer":
        log_name = "fallback.log"
        test_name = "input_classifier::tests::test_upstream_pointer_uses_heuristic_fallback"
        checks = {
            "real_v3_inference": "unavailable-upstream-lfs-pointer",
            "upstream_heuristic_fallback": "passed",
        }
    else:
        raise ValueError(f"unsupported validated model state: {model['state']}")
    lines = (output / log_name).read_text().splitlines()
    tests = [line for line in lines if line.startswith("test ") and not line.startswith("test result:")]
    summaries = [line for line in lines if line.startswith("test result:")]
    if (
        tests != [f"test {test_name} ... ok"]
        or len(summaries) != 1
        or not re.fullmatch(
            r"test result: ok\. 1 passed; 0 failed; 0 ignored; 0 measured; \d+ filtered out; finished in \S+",
            summaries[0],
        )
    ):
        raise ValueError(f"successful {test_name} evidence is missing from {log_name}")
    return checks


def source_archive(root, destination, model_path, *, policy="strict"):
    model_state = validator.validate_model(model_path, policy)
    with tempfile.TemporaryFile() as original:
        subprocess.run(
            ["git", "archive", "--format=tar", "--prefix=harp-source/", "HEAD"],
            cwd=root, stdout=original, check=True, timeout=120,
        )
        original.seek(0)
        with tarfile.open(fileobj=original, mode="r|") as source, tarfile.open(destination, "w:gz") as output:
            for entry in source:
                if entry.name == f"harp-source/{validator.MODEL_PATH.as_posix()}":
                    entry.size = model_state["size"]
                    with Path(model_path).open("rb") as model:
                        output.addfile(entry, model)
                else:
                    data = source.extractfile(entry) if entry.isfile() else None
                    output.addfile(entry, data)
    return model_state


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", required=True, type=Path)
    parser.add_argument("--version", required=True)
    parser.add_argument("--model-policy", choices=("strict", "upstream"), default="strict")
    args = parser.parse_args()
    model = validator.validate_model(ROOT / validator.MODEL_PATH, args.model_policy)
    if command("git", "status", "--porcelain"):
        raise ValueError("source changed during candidate acceptance")
    output = args.output.resolve(strict=True)
    runtime = json.loads((output / "runtime/result.json").read_text())
    source_commit = command("git", "rev-parse", "HEAD")
    libraries = validate_runtime(runtime, output / f"harp-terminal_{args.version}_amd64.deb", output / "Harp-x86_64.AppImage", source_commit)
    model_checks = validate_model_evidence(output, model)
    archived_model = source_archive(
        ROOT, output / "harp-source.tar.gz", ROOT / validator.MODEL_PATH, policy=args.model_policy,
    )
    if archived_model != model:
        raise ValueError("model payload changed during candidate acceptance")
    manifest = {
        "schema_version": 1,
        "source_commit": source_commit,
        "source_url": os.environ.get("HARP_SOURCE_URL", "https://github.com/dominikmartn/harp"),
        "app_version": tomllib.loads((ROOT / "app/Cargo.toml").read_text())["package"]["version"],
        "package_version": args.version,
        "target": "x86_64-unknown-linux-gnu",
        "build_os": "Ubuntu 24.04",
        "profile": "release",
        "features": ["gui", "release_bundle", "nld_classifier_v3", "nld_heuristic_v2"],
        "model": model,
        "rustc": command("rustc", "--version"),
        "cargo": command("cargo", "--version"),
        "cargo_about": command("cargo-about", "--version"),
        "linuxdeploy": {"tag": "1-alpha-20251107-1", "sha256": "c20cd71e3a4e3b80c3483cef793cda3f4e990aca14014d23c544ca3ce1270b4d"},
        "bundled_libraries": libraries,
        "bundled_libraries_scope": "Separate shared objects only; not an inventory of statically linked components.",
        "checks": {"model_identity": "passed", **model_checks, "clean_runtime": runtime},
        "publication": "not published",
    }
    (output / "build-manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
    with (output / "SHA256SUMS").open("w") as checksums:
        for path in sorted(output.rglob("*")):
            if path.is_file() and path.name != "SHA256SUMS" and not any(part.startswith(".") for part in path.relative_to(output).parts):
                with path.open("rb") as artifact:
                    digest = hashlib.file_digest(artifact, "sha256").hexdigest()
                checksums.write(f"{digest}  {path.relative_to(output).as_posix()}\n")


if __name__ == "__main__":
    main()
