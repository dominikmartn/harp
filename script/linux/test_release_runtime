#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: test_release_runtime --deb PATH --appimage PATH [--output-dir EMPTY_DIR]

Tests candidates sequentially in disposable official Ubuntu 24.04 amd64 containers.
Requires a local Docker daemon, GNU timeout, and permission to pull ubuntu:24.04.
Never installs packages on the host or connects to its desktop session.
stdout: result directory on success. stderr: progress and errors.
Exit: 0 passed, 1 candidate failed, 2 invalid input, 3 environment unavailable,
124 deadline exceeded, 130 interrupted, 143 terminated.

The declared AppImage desktop baseline includes Mesa software Vulkan/EGL rendering,
fontconfig, X11/Wayland libraries and fonts; it is not an any-Linux portability test.
Each container records its exact installed packages. No build/development packages
are installed. Runtime networking is disconnected and checked before candidate code.

HARP_RUNTIME_CPUS=2 HARP_RUNTIME_MEMORY=4g HARP_RUNTIME_PIDS=256
HARP_RUNTIME_WORK_SIZE=3g control Docker bounds (containers run sequentially).
Writable container layers have no claimed disk quota; app work uses bounded tmpfs.
Inputs are limited to 4 GiB each; collected logs to 1 MiB per file.
Docker client logs are limited to 32 MiB per file.
HARP_RUNTIME_MECHANICS_ONLY=1 labels fixture trials, never release approval.
HARP_RUNTIME_SOURCE_COMMIT records the source revision supplied by the build wrapper.
HARP_RUNTIME_BINFMT_COMPAT=1 permits a three-padding-byte runtime copy ONLY with
HARP_RUNTIME_MECHANICS_ONLY=1. Native tests reject conflicting AppImage handlers.
Default output: a new directory under ${TMPDIR:-/tmp}/harp-runtime.*.
Caller output must already exist, be empty, owned by the caller, and not a symlink.
EOF
}
fail() { echo "Error: $*" >&2; exit 2; }
deb= appimage= output=
while (($#)); do
  case "$1" in
    --deb|--appimage|--output-dir)
      (($# >= 2)) && [[ -n "$2" ]] || fail "Missing value for $1"
      case "$1" in
        --deb) [[ -z "$deb" ]] || fail 'Duplicate --deb'; deb=$2 ;;
        --appimage) [[ -z "$appimage" ]] || fail 'Duplicate --appimage'; appimage=$2 ;;
        --output-dir) [[ -z "$output" ]] || fail 'Duplicate --output-dir'; output=$2 ;;
      esac
      shift 2 ;;
    --help|-h) usage; exit 0 ;;
    *) fail "Unknown argument: $1" ;;
  esac
done
[[ -n "$deb" && -n "$appimage" ]] || fail '--deb and --appimage are required'
compat=${HARP_RUNTIME_BINFMT_COMPAT:-0}
[[ "$compat" =~ ^[01]$ ]] || fail 'HARP_RUNTIME_BINFMT_COMPAT must be 0 or 1'
[[ "$compat" != 1 || ${HARP_RUNTIME_MECHANICS_ONLY:-0} == 1 ]] || fail 'Binfmt compatibility requires explicit mechanics-only mode'
for tool in docker timeout realpath stat mktemp python3 sha256sum; do
  command -v "$tool" >/dev/null || { echo "Unavailable: $tool" >&2; exit 3; }
done
for path in "$deb" "$appimage"; do
  [[ -f "$path" && -r "$path" && "$path" != *','* && "$path" != *$'\n'* ]] || fail "Invalid input file: $path"
  (($(stat -c %s -- "$path") > 0 && $(stat -c %s -- "$path") <= 4 * 1024 * 1024 * 1024)) || fail "Input size out of bounds: $path"
done
deb=$(realpath -- "$deb")
appimage=$(realpath -- "$appimage")
[[ "$deb" == *.deb && "${appimage##*/}" == Harp-x86_64.AppImage ]] || fail 'Expected .deb and Harp-x86_64.AppImage'
cpus=${HARP_RUNTIME_CPUS:-2}
memory=${HARP_RUNTIME_MEMORY:-4g}
pids=${HARP_RUNTIME_PIDS:-256}
work_size=${HARP_RUNTIME_WORK_SIZE:-3g}
[[ "$cpus" =~ ^[0-9]+([.][0-9]+)?$ && "$cpus" != 0 ]] || fail 'Invalid HARP_RUNTIME_CPUS'
[[ "$pids" =~ ^[1-9][0-9]*$ ]] || fail 'Invalid HARP_RUNTIME_PIDS'
for size in "$memory" "$work_size"; do
  [[ "$size" =~ ^[1-9][0-9]*[mMgG]$ ]] || fail 'Memory and work size require a positive m/g value'
done
[[ ${HARP_RUNTIME_MECHANICS_ONLY:-0} =~ ^[01]$ ]] || fail 'HARP_RUNTIME_MECHANICS_ONLY must be 0 or 1'
source_commit=${HARP_RUNTIME_SOURCE_COMMIT:-}
[[ -z "$source_commit" || "$source_commit" =~ ^[a-f0-9]{40}$ ]] || fail 'Invalid HARP_RUNTIME_SOURCE_COMMIT'
if [[ "$compat" == 0 ]]; then
  python3 - native-preflight <<'PY'
import pathlib, sys
for handler in pathlib.Path('/proc/sys/fs/binfmt_misc').glob('*'):
    if handler.name in ('register', 'status'):
        continue
    text = handler.read_text()
    lines = text.splitlines()
    if 'enabled' in lines and 'offset 8' in lines and 'magic 414902' in lines:
        print(f'Unavailable: AppImage binfmt handler {handler.name} intercepts native execution', file=sys.stderr)
        sys.exit(3)
PY
fi
if [[ -n "$output" ]]; then
  [[ -d "$output" && ! -L "$output" && -O "$output" && -z "$(ls -A -- "$output")" ]] || fail 'Output directory must be caller-owned, empty, and not a symlink'
else
  output=$(mktemp -d "${TMPDIR:-/tmp}/harp-runtime.XXXXXXXX")
fi
output=$(realpath -- "$output")
[[ "$output" != *','* && "$output" != *$'\n'* ]] || fail 'Unsupported output path'
chmod 700 "$output"
ulimit -f 32768
cid= kind= cidfile=
docker_command() { timeout --kill-after=10s 30s docker "$@"; }
collect() {
  [[ -n "$cid" ]] || return 0
  docker_command exec "$cid" bash -c '
    mkdir -p /results/"$1"
    for file in /work/*.log /work/*.json /work/*.txt /work/*.status; do
      test -f "$file" || continue
      tail -c 1048576 "$file" | sed "/Starting warp with channel state/d" > /results/"$1"/"${file##*/}"
    done
    for file in /work/home/*.log /work/home/*.json /work/home/*.txt /work/home/*.status; do
      test -f "$file" || continue
      tail -c 1048576 "$file" | sed "/Starting warp with channel state/d" > /results/"$1"/user-"${file##*/}"
    done
    chown -R "$2:$3" /results/"$1"
  ' _ "$kind" "$(id -u)" "$(id -g)" >/dev/null 2>&1 || true
}
cleanup() {
  local status=$?
  trap - EXIT INT TERM
  if [[ -z "$cid" && -n "$cidfile" && -s "$cidfile" ]]; then cid=$(cat "$cidfile"); fi
  if [[ "$cid" =~ ^[a-f0-9]{64}$ ]]; then
    collect
    docker_command rm --force "$cid" >>"$output/cleanup.log" 2>&1 || {
      echo "Error: failed to remove owned container $cid; see $output/cleanup.log" >&2
      if ((status == 0)); then status=3; fi
    }
  fi
  printf '%s\n' "$status" > "$output/exit-status"
  echo "Runtime gate logs: $output (exit $status)" >&2
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
if ! docker_command info --format '{{.OSType}}' >"$output/docker.txt" 2>&1; then
  echo 'Unavailable: Docker daemon' >&2; exit 3
fi
[[ $(cat "$output/docker.txt") == linux ]] || { echo 'Unavailable: Linux Docker daemon required' >&2; exit 3; }
# Remote daemons would resolve bind paths on another machine.
endpoint=$(docker_command context inspect --format '{{.Endpoints.docker.Host}}')
[[ ${DOCKER_HOST:-$endpoint} == unix://* ]] || { echo 'Unavailable: a local Unix-socket Docker daemon is required' >&2; exit 3; }
if ! docker_command image inspect ubuntu:24.04 >/dev/null 2>&1; then
  echo 'Pulling official Ubuntu 24.04 amd64 image...' >&2
  status=0
  timeout --kill-after=10s 180s docker pull --platform linux/amd64 ubuntu:24.04 >"$output/pull.log" 2>&1 || status=$?
  if ((status)); then ((status == 124)) && exit 124; exit 3; fi
fi
image=$(docker_command image inspect ubuntu:24.04 --format '{{index .RepoDigests 0}}')
[[ "$image" == ubuntu@sha256:* ]] || { echo 'Unavailable: official Ubuntu digest could not be resolved' >&2; exit 3; }
printf '%s\n' "$image" > "$output/image.txt"
printf 'cpus=%s\nmemory=%s\npids=%s\nwork_tmpfs=%s\n' "$cpus" "$memory" "$pids" "$work_size" > "$output/limits.txt"
printf '%s\n' "${HARP_RUNTIME_MECHANICS_ONLY:-0}" > "$output/mechanics-only"
sha256sum -- "$deb" "$appimage" > "$output/inputs.sha256"

for kind in deb appimage; do
  echo "Preparing isolated $kind runtime..." >&2
  cidfile="$output/$kind.cid"
  package=$deb; target=/candidate.deb
  if [[ "$kind" == appimage ]]; then package=$appimage; target=/Harp-x86_64.AppImage; fi
  cid=$(docker_command create --cidfile "$cidfile" --platform linux/amd64 --init \
    --network bridge --security-opt no-new-privileges --cpus "$cpus" --memory "$memory" \
    --memory-swap "$memory" --pids-limit "$pids" --log-driver none \
    --tmpfs "/work:rw,exec,nosuid,nodev,size=$work_size,mode=1777" \
    --tmpfs /tmp:rw,nosuid,nodev,size=256m,mode=1777 \
    --mount "type=bind,src=$package,dst=$target,readonly" \
    --mount "type=bind,src=$output,dst=/results" \
    "$image" timeout 1800s sleep infinity)
  docker_command start "$cid" >/dev/null
  status=0
  timeout --kill-after=10s 600s docker exec -i "$cid" bash -se -- "$kind" >"$output/$kind-preparation.log" 2>&1 <<'PREPARE' || status=$?
export DEBIAN_FRONTEND=noninteractive
set -E
trap 'echo "Preparation failed at line $LINENO: $BASH_COMMAND" >&2' ERR
test "$(dpkg --print-architecture)" = amd64
. /etc/os-release
test "$ID:$VERSION_ID" = ubuntu:24.04
apt-get -o Acquire::Retries=0 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update
# This is the supported desktop baseline, not a development environment.
baseline=(ca-certificates xvfb xauth x11-utils xdotool dbus-daemon util-linux python3 file
  fontconfig fonts-dejavu-core libasound2t64 libegl1 libgl1 libgl1-mesa-dri mesa-vulkan-drivers
  libvulkan1 libwayland-client0 libwayland-egl1 libx11-6 libxcb1 libxcursor1 libxi6
  libxkbcommon-x11-0 zlib1g)
printf '%s\n' "${baseline[@]}" > /work/baseline.txt
apt-get -o Acquire::Retries=0 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 install -y --no-install-recommends "${baseline[@]}"
if [[ "$1" == deb ]]; then
  test "$(dpkg-deb -f /candidate.deb Package)" = harp-terminal || exit 40
  test "$(dpkg-deb -f /candidate.deb Architecture)" = amd64 || exit 40
  dpkg-deb -f /candidate.deb Version > /work/package-version.txt
  dpkg-deb -e /candidate.deb /work/control
  # OSS packages must not ship installation/removal hooks at all.
  for hook in preinst postinst prerm postrm; do test ! -e "/work/control/$hook" || exit 40; done
  apt-get -o Acquire::Retries=0 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 install -y --download-only --no-install-recommends /candidate.deb
fi
useradd --uid 1001 --create-home --home-dir /work/home --shell /bin/bash harp-test
mkdir -p /work/home /work/runtime /work/tmp
chown -R 1001:1001 /work/home /work/runtime /work/tmp
chmod 700 /work/runtime
dpkg-query -W -f='${Package}\t${Version}\n' > /work/packages-before.txt
if grep -E -- '(-dev[[:space:]]|^build-essential[[:space:]])' /work/packages-before.txt; then exit 1; fi
PREPARE
  if ((status)); then
    ((status == 124)) && exit 124
    if ((status == 40)); then echo "Error: invalid $kind package" >&2; exit 1; fi
    echo "Unavailable: $kind preparation failed" >&2; exit 3
  fi
  docker_command network disconnect bridge "$cid"
  docker_command inspect "$cid" --format '{{json .NetworkSettings.Networks}}' > "$output/$kind-network.json"
  [[ $(cat "$output/$kind-network.json") == '{}' ]] || { echo 'Error: runtime network is not disconnected' >&2; exit 3; }
  echo "Checking $kind with networking disabled..." >&2
  status=0
  timeout --kill-after=10s 300s docker exec -i "$cid" bash -se -- "$kind" "$compat" >"$output/$kind-runtime.log" 2>&1 <<'RUNTIME' || status=$?
snapshot() {
  find /etc/apt /usr/share/keyrings -printf '%y %p %l\n' | sort
  find /etc/apt /usr/share/keyrings -type f -exec sha256sum '{}' + | sort
}
set -E
trap 'echo "Runtime failed at line $LINENO: $BASH_COMMAND" >&2' ERR
snapshot > /work/apt-before.txt
if [[ "$1" == deb ]]; then
  timeout 90s dpkg --unpack /candidate.deb
  timeout 90s apt-get install -y --no-download --no-install-recommends --fix-broken
  test "$(readlink -f /usr/bin/harp)" = /opt/harp-terminal/warp-oss
  test "$(readlink -f /usr/bin/warp-terminal-oss)" = /opt/harp-terminal/warp-oss
  grep -Eq '^Exec=harp([[:space:]]|$)' /usr/share/applications/com.dominikmartn.Harp.desktop
  mkdir /work/package-content
  timeout 60s dpkg-deb -x /candidate.deb /work/package-content
  cat /etc/dpkg/dpkg.cfg /etc/dpkg/dpkg.cfg.d/* > /work/dpkg-policy.txt
  for f in LICENSE-AGPL LICENSE-MIT THIRD_PARTY_LICENSES.txt copyright SOURCE; do
    test -s "/work/package-content/usr/share/doc/harp-terminal/$f"
  done
  rm -rf /work/package-content
  dpkg-query -L harp-terminal > /work/package-paths.txt
  while IFS= read -r path; do
    if [[ -L "$path" || -f "$path" ]]; then printf '%s\n' "$path"; fi
  done < /work/package-paths.txt > /work/package-files.txt
fi
snapshot > /work/apt-installed.txt
diff -u /work/apt-before.txt /work/apt-installed.txt
dpkg-query -W -f='${Package}\t${Version}\n' > /work/packages-runtime.txt
cat > /work/user-test <<'USERTEST'
#!/bin/bash
set -euo pipefail
set -E
trap 'echo "User runtime failed at line $LINENO: $BASH_COMMAND" >&2' ERR
cd /work/home
kind=$1
if [[ "$kind" == appimage ]]; then
  launcher=/Harp-x86_64.AppImage
  if [[ "$HARP_RUNTIME_BINFMT_COMPAT" == 1 ]]; then
    python3 - <<'PY'
import errno, hashlib, json, pathlib, shutil, sys
original = pathlib.Path('/Harp-x86_64.AppImage')
launcher = pathlib.Path('/work/tmp/appimage-runtime')
def digest(path):
    with path.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()
before = digest(original)
with original.open('rb') as stream:
    stream.seek(8)
    assert stream.read(3) == b'AI\x02', 'Expected AppImage type 2 header'
try:
    shutil.copyfile(original, launcher)
    with launcher.open('r+b') as stream:
        stream.seek(8)
        stream.write(b'\0\0\0')
    with original.open('rb') as source, launcher.open('rb') as copy:
        offset = 0
        while chunk := source.read(1048576):
            expected = bytearray(chunk)
            if offset == 0:
                expected[8:11] = b'\0\0\0'
            assert copy.read(len(chunk)) == expected, 'Runtime copy differs outside padding'
            offset += len(chunk)
        assert copy.read(1) == b'', 'Runtime copy length changed'
    launcher.chmod(0o700)
    assert digest(original) == before, 'Original AppImage changed'
    pathlib.Path('/work/home/launcher.json').write_text(json.dumps({
        'launcher_source': 'candidate-copy',
        'launcher_sha256': digest(launcher),
        'launcher_original_sha256': before,
    }) + '\n')
except OSError as error:
    if error.errno in (errno.ENOSPC, errno.EDQUOT):
        print(f'Unavailable: runtime work filesystem: {error}', file=sys.stderr)
        sys.exit(41)
    raise
PY
    launcher=/work/tmp/appimage-runtime
    status=0
    TARGET_APPIMAGE=/work/nonexistent.AppImage timeout 15s "$launcher" dump-settings-schema /work/home/negative-schema.json > /work/home/negative-target.log 2>&1 || status=$?
    if ((status == 0 || status == 124)) || [[ -e /work/home/negative-schema.json ]]; then
      echo 'Error: candidate runtime did not reject nonexistent TARGET_APPIMAGE' >&2
      exit 1
    fi
  fi
  mkdir /work/tmp/extracted
  cd /work/tmp/extracted
  timeout 60s "$launcher" --appimage-extract > /work/home/extraction.log
  root=$PWD/squashfs-root
  binary=$root/opt/harp-terminal/warp-oss
  resources=$root/opt/harp-terminal/resources
  test -x "$root/AppRun"
  test -s "$root/usr/share/applications/com.dominikmartn.Harp.desktop"
  test "$(readlink "$root/opt/lib")" = ../usr/lib
  test "$(realpath "$root/opt/lib")" = "$root/usr/lib"
  launch=("$launcher")
else
  binary=/opt/harp-terminal/warp-oss
  resources=/opt/harp-terminal/resources
  launch=(/usr/bin/harp)
fi
python3 - "$resources" /work/home/resource-permissions.json <<'RESOURCE_PERMISSIONS'
import json, os, pathlib, stat, sys
resources = pathlib.Path(sys.argv[1])
entries = []
pending = [resources]
while pending:
    path = pending.pop()
    relative = str(path.relative_to(resources))
    entry = {'path': relative, 'errors': []}
    entries.append(entry)
    try:
        mode = path.lstat().st_mode
        permissions = stat.S_IMODE(mode)
        entry['mode'] = f'{permissions:04o}'
        if stat.S_ISLNK(mode):
            entry['type'] = 'symlink'
            entry['target'] = os.readlink(path)
        elif stat.S_ISDIR(mode):
            entry['type'] = 'directory'
            if permissions & 0o005 != 0o005:
                entry['errors'].append('Directory must be world readable and searchable')
            with os.scandir(path) as children:
                pending.extend(sorted((pathlib.Path(child.path) for child in children), reverse=True))
        elif stat.S_ISREG(mode):
            entry['type'] = 'file'
            if not permissions & 0o004:
                entry['errors'].append('File must be world readable')
        else:
            entry['type'] = 'other'
            entry['errors'].append('Unsupported resource type')
        if relative == '.' and entry['type'] != 'directory':
            entry['errors'].append('Resource root must be a directory')
        if relative == 'settings_schema.json':
            if entry['type'] != 'file' or permissions != 0o644:
                entry['errors'].append('Bundled schema must be a regular file with mode 0644')
    except OSError as error:
        entry['errors'].append(str(error))
if not any(entry['path'] == 'settings_schema.json' for entry in entries):
    entries.append({'path': 'settings_schema.json', 'errors': ['Bundled schema was not audited']})
failed = any(entry['errors'] for entry in entries)
pathlib.Path(sys.argv[2]).write_text(json.dumps({
    'resources': str(resources), 'status': 'failed' if failed else 'passed', 'entries': entries,
}, indent=2) + '\n')
if failed:
    print('Error: resource permission audit failed; see resource-permissions.json', file=sys.stderr)
    sys.exit(1)
RESOURCE_PERMISSIONS
if [[ "$kind" == appimage ]]; then
  for f in LICENSE-AGPL LICENSE-MIT copyright SOURCE; do test -s "$resources/$f"; done
fi
file "$binary" | tee /work/home/binary.txt | grep -q 'ELF 64-bit.*x86-64'
ldd "$binary" > /work/home/ldd.txt
if grep 'not found' /work/home/ldd.txt; then
  echo 'Error: unresolved runtime libraries' >&2
  exit 1
fi
if [[ "$kind" == appimage ]]; then
  python3 - "$root" /work/home/ldd.txt /work/home/bundled-libraries.json <<'BUNDLED_LIBRARIES'
import hashlib, json, os, pathlib, re, stat, sys

MAX_ENTRIES = 100000
root = pathlib.Path(sys.argv[1])
allowed = 'usr/lib/liblzma.so.5'
libraries = []
pending = [root]
scanned = 0
while pending:
    path = pending.pop()
    scanned += 1
    if scanned > MAX_ENTRIES:
        raise SystemExit(f'Error: AppImage inventory exceeds {MAX_ENTRIES} entries')
    mode = path.lstat().st_mode
    relative = str(path.relative_to(root))
    if '.so' in path.name:
        if relative != allowed or not stat.S_ISREG(mode):
            raise SystemExit(f'Error: unexpected bundled library: {relative}')
        with path.open('rb') as stream:
            digest = hashlib.file_digest(stream, 'sha256').hexdigest()
        libraries.append({'path': relative, 'soname': path.name, 'sha256': digest})
    elif stat.S_ISDIR(mode):
        with os.scandir(path) as children:
            for child in children:
                if scanned + len(pending) >= MAX_ENTRIES:
                    raise SystemExit(f'Error: AppImage inventory exceeds {MAX_ENTRIES} entries')
                pending.append(pathlib.Path(child.path))
libraries.sort(key=lambda library: library['path'])
pathlib.Path(sys.argv[3]).write_text(json.dumps(libraries) + '\n')
ldd = pathlib.Path(sys.argv[2]).read_text()
if 'not found' in ldd:
    raise SystemExit('Error: unresolved runtime libraries')
lzma = [line.strip() for line in ldd.splitlines() if re.search(r'\bliblzma\.so\b', line)]
if libraries:
    expected = f'{root}/opt/harp-terminal/../lib/liblzma.so.5'
    resolution = rf'liblzma\.so\.5\s+=>\s+{re.escape(expected)}\s+\(0x[0-9a-fA-F]+\)'
    if len(lzma) != 1 or not re.fullmatch(resolution, lzma[0]):
        raise SystemExit('Error: bundled liblzma must resolve from the AppImage')
elif lzma:
    raise SystemExit('Error: unbundled liblzma found in the runtime dependency tree')
BUNDLED_LIBRARIES
  if grep -E "libasound.so.2 => $root/" /work/home/ldd.txt; then
    echo 'Error: ALSA must be provided by the host desktop' >&2
    exit 1
  fi
fi
test -s "$resources/THIRD_PARTY_LICENSES.txt"
test -d "$resources/bundled/skills"
