import pathlib
environment = dict(line.split('=', 1) for line in pathlib.Path('/work/home/shell-env.txt').read_text().splitlines() if '=' in line)
assert not environment.get('LD_LIBRARY_PATH'), 'Bundled library search leaked into the shell'
assert not environment.get('LD_PRELOAD'), 'Library preload leaked into the shell'
assert '/work/tmp/' not in environment.get('PATH', ''), 'AppImage mount leaked into shell PATH'
PY
xdotool key --clearmodifiers ctrl+shift+t
deadline=$((SECONDS + 45))
until [[ $(grep -Rh 'Shell is bootstrapped with session_id' /work/home/state | wc -l) -ge 2 ]]; do
  kill -0 "$app_pid"
  ((SECONDS < deadline)) || exit 124
  sleep 0.2
done
xdotool type --clearmodifiers --delay 15 "printf '%s\\n' \"\$\$\" > /work/home/second-shell.pid; printf 'HARP_SECOND_TAB_OK\\n' > /work/home/second-tab-marker"
xdotool key --clearmodifiers Return
deadline=$((SECONDS + 45))
until [[ -f /work/home/second-tab-marker ]] && grep -qx HARP_SECOND_TAB_OK /work/home/second-tab-marker; do
  kill -0 "$app_pid"
  ((SECONDS < deadline)) || exit 124
  sleep 0.2
done
printf 'second-tab-marker: %s\n' "$(cat /work/home/second-tab-marker)" >> /work/home/terminal-proof.txt
# Exit the second shell before closing the original tab.
xdotool type --clearmodifiers --delay 30 'exit'
xdotool key --clearmodifiers Return
deadline=$((SECONDS + 20))
while kill -0 "$(cat /work/home/second-shell.pid)" 2>/dev/null; do
  kill -0 "$app_pid"
  ((SECONDS < deadline)) || exit 124
  sleep 0.2
done
kill -0 "$app_pid"
if grep -Ei 'panicked at|thread .* panicked|fatal runtime error' /work/home/app.log; then exit 1; fi
find /work/home/state -type f -name '*.log' -exec cat '{}' + >> /work/home/app.log
if grep -Ei 'panicked at|thread .* panicked|fatal runtime error' /work/home/app.log; then exit 1; fi
grep -Ei 'adapter|vulkan|renderer|llvmpipe|wgpu' /work/home/app.log > /work/home/adapter.log
# Closing the shell is an ordinary GUI exit, not a signal-based test stop.
xdotool type --clearmodifiers --delay 30 'exit'
xdotool key --clearmodifiers Return
deadline=$((SECONDS + 20))
while kill -0 "$app_pid" 2>/dev/null; do
  ((SECONDS < deadline)) || exit 124
  sleep 0.2
done
status=0
wait "$app_pid" || status=$?
app_pid=
printf '%s\n' "$status" > /work/home/app-exit.status
test "$status" = 0
if grep -Ei 'panicked at|thread .* panicked|fatal runtime error' /work/home/app.log; then exit 1; fi
USERTEST
chmod 755 /work/user-test
status=0
timeout --kill-after=5s 210s setpriv --reuid=1001 --regid=1001 --init-groups \
  --bounding-set=-all --no-new-privs env -i PATH=/usr/bin:/bin HOME=/work/home \
  USER=harp-test LOGNAME=harp-test SHELL=/bin/bash LANG=C.UTF-8 \
  XDG_RUNTIME_DIR=/work/runtime XDG_CONFIG_HOME=/work/home/config \
  XDG_DATA_HOME=/work/home/data XDG_CACHE_HOME=/work/home/cache \
  XDG_STATE_HOME=/work/home/state TMPDIR=/work/tmp DISPLAY=:99 \
  LIBGL_ALWAYS_SOFTWARE=1 WGPU_BACKEND=vulkan APPIMAGE_EXTRACT_AND_RUN=1 \
  TARGET_APPIMAGE=/Harp-x86_64.AppImage HARP_RUNTIME_BINFMT_COMPAT="$2" \
  RUST_LOG=info WARPOSS_SKIP_LOGIN=1 dbus-run-session -- bash /work/user-test "$1" || status=$?
for f in /work/home/*.log /work/home/*.json /work/home/*.txt /work/home/*.status; do
  test ! -f "$f" || tail -c 1048576 "$f" > "/work/${f##*/}"
done
((status == 0)) || exit "$status"
if [[ "$1" == deb ]]; then
  timeout 60s apt-get purge -y harp-terminal
  for f in /usr/bin/harp /usr/bin/warp-terminal-oss /opt/harp-terminal /usr/share/applications/com.dominikmartn.Harp.desktop; do
    test ! -e "$f" && test ! -L "$f"
  done
  while IFS= read -r path; do test ! -e "$path" && test ! -L "$path"; done < /work/package-files.txt
fi
snapshot > /work/apt-after.txt
diff -u /work/apt-before.txt /work/apt-after.txt
RUNTIME
  collect
  docker_command rm --force "$cid" >>"$output/cleanup.log" 2>&1
  cid=
  cidfile=
  if ((status)); then
    ((status == 124)) && exit 124
    if ((status == 41)) || grep -qEi 'No space left on device|Disk quota exceeded' "$output/$kind-runtime.log" "$output/$kind/"*.log; then
      echo 'Unavailable: runtime work filesystem capacity exceeded' >&2; exit 3
    fi
    echo "Error: $kind runtime failed (command exit $status)" >&2; exit 1
  fi
done
classification=candidate-runtime-tested
if [[ ${HARP_RUNTIME_MECHANICS_ONLY:-0} == 1 ]]; then classification=mechanics-only; fi
printf '%s; not release authorization\n' "$classification" > "$output/result.txt"
sha256sum --check "$output/inputs.sha256" > "$output/inputs-unchanged.txt"
python3 - "$output" "$image" "${HARP_RUNTIME_MECHANICS_ONLY:-0}" "$compat" "$source_commit" <<'PY'
import json, pathlib, sys
output = pathlib.Path(sys.argv[1])
hashes = [line.split()[0] for line in (output / 'inputs.sha256').read_text().splitlines()]
result = {
    'status': 'passed',
    'mechanics_only': sys.argv[3] == '1',
    'source_commit': sys.argv[5],
    'image_digest': sys.argv[2],
    'inputs': dict(zip(('deb', 'appimage'), hashes)),
    'baseline': (output / 'appimage/baseline.txt').read_text().splitlines(),
    'bundled_libraries': json.loads((output / 'appimage/bundled-libraries.json').read_text()),
    'launch_mode': 'external-runtime-binfmt-compat' if sys.argv[4] == '1' else 'native-direct-exec',
}
if sys.argv[4] == '1':
    assert result['mechanics_only'] is True
    result.update(json.loads((output / 'appimage/launcher.json').read_text()))
    assert result['launcher_original_sha256'] == result['inputs']['appimage']
(output / 'result.json').write_text(json.dumps(result, indent=2) + '\n')
PY
printf '%s\n' "$output"
